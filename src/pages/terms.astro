	}

	.home-link {
		display: inline-block;
		margin-bottom: 2rem;
		font-size: 0.9375rem;
		font-weight: 500;
		color: var(--color-text-muted);
		transition: color 0.2s;
	}

	.home-link:hover {
		color: var(--color-text);
		text-decoration: none;
	}

	h1 {
		font-size: 2rem;
		font-weight: 700;
		margin-bottom: 2rem;
	}

	.effective-date {
		margin-bottom: 1rem;
	}

	.effective-date .label {
		font-weight: 700;
		margin-right: 0.25rem;
	}

	p {
		margin-bottom: 1rem;
		line-height: 1.7;
	}

	ul {
		list-style: none;
		padding: 0;
	}

	li {
		margin-bottom: 1.5rem;
	}

	li h2 {
		font-size: 1.125rem;
		font-weight: 700;
		margin-bottom: 0.5rem;
	}

	li p {
		margin-bottom: 0.5rem;
	}

	.notice {
		font-weight: 600;
		margin: 1.5rem 0 2rem;
	}

	strong {
		color: var(--color-heading);
	}

	.disc-list {
		list-style: disc;
		padding-left: 2rem;
		margin-bottom: 1rem;
	}

	.disc-list li {
		margin-bottom: 0.25rem;
	}

	a {
		color: var(--color-primary);
		text-decoration: underline;
	}

	a:hover {
		opacity: 0.8;
	}
</style>
