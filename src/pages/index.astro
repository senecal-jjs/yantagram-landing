---
import Hero from '../components/Hero.astro';
import Features from '../components/Features.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Security from '../components/Security.astro';
import Comparison from '../components/Comparison.astro';
import Footer from '../components/Footer.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<Hero />
	<HowItWorks />
	<Features />
	<Comparison />
	<Security />
	<Footer />

	<div class="beta-modal" id="beta-modal" hidden>
		<div class="beta-modal__backdrop" data-close-beta-modal></div>
		<div
			class="beta-modal__dialog"
			role="dialog"
			aria-modal="true"
			aria-labelledby="beta-modal-title"
			aria-describedby="beta-modal-description"
		>
			<button type="button" class="beta-modal__close" aria-label="Close beta modal" data-close-beta-modal>
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<line x1="18" y1="6" x2="6" y2="18"></line>
					<line x1="6" y1="6" x2="18" y2="18"></line>
				</svg>
			</button>

			<p class="beta-modal__eyebrow">Private beta</p>
			<h2 id="beta-modal-title">Yantagram is currently in private beta.</h2>
			<p id="beta-modal-description">
				If you would like to join the beta test, send an email request to dev@yantagram.com and we will follow up with access details.
			</p>

			<div class="beta-modal__actions">
				<a
					href="mailto:dev@yantagram.com?subject=Yantagram%20Beta%20Request&body=Hi%20Yantagram%20team%2C%0A%0AI%20would%20like%20to%20join%20the%20private%20beta.%0A%0AName%3A%0APlatform%20(iOS%2FAndroid)%3A%0A%0AThanks%21"
					class="btn btn-primary beta-modal__primary"
				>
					Email dev@yantagram.com
				</a>
			</div>
		</div>
	</div>
</Layout>

<style>
	.beta-modal[hidden] {
		display: none;
	}

	.beta-modal {
		position: fixed;
		inset: 0;
		z-index: 1200;
		display: grid;
		place-items: center;
		padding: 20px;
	}

	.beta-modal__backdrop {
		position: absolute;
		inset: 0;
		background: rgba(8, 6, 32, 0.72);
		backdrop-filter: blur(8px);
	}

	.beta-modal__dialog {
		position: relative;
		z-index: 1;
		width: min(560px, 100%);
		padding: 36px;
		border-radius: var(--radius-xl);
		border: 1px solid color-mix(in srgb, var(--color-primary) 35%, transparent);
		background: var(--color-bg);
		box-shadow: 0 30px 80px rgba(6, 4, 30, 0.55);
	}

	.beta-modal__close {
		position: absolute;
		top: 20px;
		right: 20px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 44px;
		height: 44px;
		border: none;
		border-radius: 50%;
		background: var(--color-surface);
		color: var(--color-text);
		cursor: pointer;
		transition: border-color 0.2s, color 0.2s, background 0.2s;
	}

	.beta-modal__close:hover {
		color: var(--color-heading);
		background: var(--color-surface-raised);
	}

	.beta-modal__eyebrow {
		display: inline-flex;
		margin-bottom: 12px;
		color: var(--color-label);
		font-size: 0.75rem;
		font-weight: 600;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	.beta-modal h2 {
		font-size: clamp(1.3rem, 3vw, 1.8rem);
		margin-bottom: 12px;
		padding-right: 48px;
	}

	.beta-modal p {
		color: var(--color-text-muted);
		line-height: 1.7;
		font-size: 1rem;
	}

	.beta-modal__actions {
		display: flex;
		justify-content: center;
		gap: 12px;
		flex-wrap: wrap;
		margin-top: 24px;
	}

	.beta-modal__primary {
		width: 100%;
	}

	body.beta-modal-open {
		overflow: hidden;
	}

	@media (max-width: 640px) {
		.beta-modal {
			padding: 16px;
		}

		.beta-modal__dialog {
			padding: 24px 18px 18px;
		}

		.beta-modal__actions {
			flex-direction: column;
		}

	}
</style>

<script is:inline>
	(function() {
		var modal = document.getElementById('beta-modal');
		if (!modal) {
			return;
		}

		var openers = document.querySelectorAll('[data-open-beta-modal]');
		var closers = modal.querySelectorAll('[data-close-beta-modal]');
		var firstFocusable = modal.querySelector('.beta-modal__close');
		var lastTrigger = null;

		function openModal(trigger) {
			lastTrigger = trigger || document.activeElement;
			modal.hidden = false;
			document.body.classList.add('beta-modal-open');
			if (firstFocusable) {
				firstFocusable.focus();
			}
		}

		function closeModal() {
			modal.hidden = true;
			document.body.classList.remove('beta-modal-open');
			if (lastTrigger && typeof lastTrigger.focus === 'function') {
				lastTrigger.focus();
			}
		}

		openers.forEach(function(opener) {
			opener.addEventListener('click', function() {
				openModal(opener);
			});
		});

		closers.forEach(function(closer) {
			closer.addEventListener('click', function() {
				closeModal();
			});
		});

		document.addEventListener('keydown', function(event) {
			if (event.key === 'Escape' && !modal.hidden) {
				closeModal();
			}
		});
	})();
</script>
