---
---

<section id="security">
	<div class="container">
		<div class="security-layout">
			<div class="security-text">
				<div class="section-label">Security</div>
				<h2>Privacy by default</h2>
				<p>
                    Yantagram enforces privacy and security by default. All messages are end-to-end encrypted and can be retained on device for a 
                    maximum of one week.
				</p>
				<p>
                    No personally identifiable information is needed to use Yantagram. No names, phone numbers or emails. Contacts are added by scanning another user's unique QR code. 
				</p>

				<div class="security-highlights">
					<div class="highlight">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
						<span>Zero-knowledge relay — nodes can't decrypt traffic</span>
					</div>
					<div class="highlight">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
						<span>Forward secrecy via continuous key rotation</span>
					</div>
					<div class="highlight">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
						<span>Out-of-band identity verification via QR</span>
					</div>
				</div>
			</div>

			<div class="security-icon">
				<svg width="280" height="280" viewBox="0 0 24 24" fill="none" stroke="url(#shieldGrad)" stroke-width="0.5" stroke-linecap="round" stroke-linejoin="round">
					<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
					<path d="M9 12l2 2 4-4" stroke-width="1"/>
					<defs>
						<linearGradient id="shieldGrad" x1="4" y1="2" x2="20" y2="22">
							<stop stop-color="var(--color-primary)"/>
							<stop offset="1" stop-color="var(--color-accent)"/>
						</linearGradient>
					</defs>
				</svg>
			</div>
		</div>
	</div>
</section>

<style>
	#security {
		padding: 140px 0;
		border-top: 1px solid var(--color-surface-border);
	}

	.security-layout {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 80px;
		align-items: start;
	}

	.section-label {
		font-size: 0.75rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--color-accent);
		margin-bottom: 16px;
	}

	.security-text h2 {
		font-size: clamp(2rem, 4vw, 2.75rem);
		font-weight: 700;
		margin-bottom: 24px;
	}

	.security-text p {
		color: var(--color-text-muted);
		margin-bottom: 16px;
		line-height: 1.75;
	}

	.security-text strong {
		color: var(--color-text);
	}

	.security-highlights {
		display: flex;
		flex-direction: column;
		gap: 12px;
		margin-top: 32px;
	}

	.highlight {
		display: flex;
		align-items: center;
		gap: 12px;
		font-size: 0.875rem;
		color: var(--color-text);
	}

	.security-icon {
		display: flex;
		align-items: center;
		justify-content: center;
		opacity: 0.85;
	}

	@media (max-width: 1024px) {
		.security-layout {
			grid-template-columns: 1fr;
			gap: 48px;
		}

		.security-icon {
			order: -1;
		}

		.security-icon svg {
			width: 180px;
			height: 180px;
		}
	}

	@media (max-width: 640px) {
		#security {
			padding: 100px 0;
		}
	}
</style>
