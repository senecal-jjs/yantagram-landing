---
const cryptoStack = [
	{ category: "Symmetric Encryption", protocol: "XChaCha20-Poly1305", strength: "256-bit" },
	{ category: "Key Exchange", protocol: "X25519 (Curve25519)", strength: "~128-bit" },
	{ category: "Digital Signatures", protocol: "Ed25519", strength: "~128-bit" },
	{ category: "Hashing", protocol: "BLAKE3 / SHA-256", strength: "256-bit" },
	{ category: "Key Derivation", protocol: "HKDF-SHA-512", strength: "512-bit" },
	{ category: "Group Key Agreement", protocol: "BeeKEM (CGKA)", strength: "Continuous" },
];
---

<section id="security">
	<div class="container">
		<div class="security-layout">
			<div class="security-text">
				<div class="section-label">Security</div>
				<h2>Modern cryptography.<br />No compromises.</h2>
				<p>
					Every message is encrypted with a unique session key that only the intended
					recipient can derive. Relay nodes see nothing but opaque ciphertext.
				</p>
				<p>
					Group conversations use <strong>BeeKEM</strong> — a concurrent group key agreement
					protocol designed for unreliable transport like Bluetooth mesh. Keys rotate
					automatically as members join or leave.
				</p>

				<div class="security-highlights">
					<div class="highlight">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
						<span>Zero-knowledge relay — nodes can't decrypt traffic</span>
					</div>
					<div class="highlight">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
						<span>Forward secrecy via continuous key rotation</span>
					</div>
					<div class="highlight">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
						<span>Out-of-band identity verification via QR</span>
					</div>
					<div class="highlight">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
						<span>Post-quantum migration path planned</span>
					</div>
				</div>
			</div>

			<div class="crypto-card">
				<div class="crypto-header">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
					<span>Cryptographic Suite</span>
				</div>
				<div class="crypto-list">
					{cryptoStack.map((item) => (
						<div class="crypto-row">
							<div class="crypto-info">
								<span class="crypto-category">{item.category}</span>
								<code class="crypto-protocol">{item.protocol}</code>
							</div>
							<span class="crypto-strength">{item.strength}</span>
						</div>
					))}
				</div>
				<div class="crypto-warning">
					<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
					<span>Security has not been formally audited. Use at your own discretion.</span>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	#security {
		padding: 140px 0;
		border-top: 1px solid var(--color-surface-border);
	}

	.security-layout {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 80px;
		align-items: start;
	}

	.section-label {
		font-size: 0.75rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--color-primary);
		margin-bottom: 16px;
	}

	.security-text h2 {
		font-size: clamp(2rem, 4vw, 2.75rem);
		font-weight: 700;
		margin-bottom: 24px;
	}

	.security-text p {
		color: var(--color-text-muted);
		margin-bottom: 16px;
		line-height: 1.75;
	}

	.security-text strong {
		color: var(--color-text);
	}

	.security-highlights {
		display: flex;
		flex-direction: column;
		gap: 12px;
		margin-top: 32px;
	}

	.highlight {
		display: flex;
		align-items: center;
		gap: 12px;
		font-size: 0.875rem;
		color: var(--color-text);
	}

	.crypto-card {
		background: var(--color-surface);
		border: 1px solid var(--color-surface-border);
		border-radius: var(--radius-lg);
		padding: 28px;
		position: sticky;
		top: 40px;
	}

	.crypto-header {
		display: flex;
		align-items: center;
		gap: 8px;
		font-size: 0.8125rem;
		font-weight: 500;
		color: var(--color-text-muted);
		margin-bottom: 24px;
		padding-bottom: 16px;
		border-bottom: 1px solid var(--color-surface-border);
	}

	.crypto-list {
		display: flex;
		flex-direction: column;
		gap: 0;
	}

	.crypto-row {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 14px 0;
		border-bottom: 1px solid var(--color-surface-border);
	}

	.crypto-row:last-child {
		border-bottom: none;
	}

	.crypto-info {
		display: flex;
		flex-direction: column;
		gap: 4px;
	}

	.crypto-category {
		font-size: 0.75rem;
		color: var(--color-text-muted);
	}

	.crypto-protocol {
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		color: var(--color-text);
		background: none;
		padding: 0;
	}

	.crypto-strength {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		color: var(--color-primary);
		background: var(--color-primary-dim);
		padding: 3px 8px;
		border-radius: 4px;
		white-space: nowrap;
	}

	.crypto-warning {
		display: flex;
		align-items: flex-start;
		gap: 10px;
		margin-top: 20px;
		padding: 14px 16px;
		background: rgba(250, 204, 21, 0.05);
		border: 1px solid rgba(250, 204, 21, 0.15);
		border-radius: var(--radius-sm);
		color: rgba(250, 204, 21, 0.8);
		font-size: 0.75rem;
		line-height: 1.5;
	}

	.crypto-warning svg {
		flex-shrink: 0;
		margin-top: 1px;
	}

	@media (max-width: 1024px) {
		.security-layout {
			grid-template-columns: 1fr;
			gap: 48px;
		}

		.crypto-card {
			position: static;
		}
	}

	@media (max-width: 640px) {
		#security {
			padding: 100px 0;
		}

		.crypto-card {
			padding: 20px;
		}

		.crypto-row {
			flex-direction: column;
			align-items: flex-start;
			gap: 8px;
		}
	}
</style>
