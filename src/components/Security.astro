---
import PhoneFrame from './PhoneFrame.astro';
import contactScreen from '../assets/screens/contact.jpg';
---

<section id="security">
	<div class="container">
		<div class="security-layout">
			<div class="security-text">
				<div class="section-label">Security</div>
				<h2>Privacy by default</h2>
				<p>
                    Yantagram enforces privacy and security by default. All messages are end-to-end encrypted and can be retained on device for a 
                    maximum of one week.
				</p>
				<p>
                    No personally identifiable information is needed to use Yantagram. No names, phone numbers or emails. Contacts are added by scanning another user's unique QR code. 
				</p>

				<div class="security-highlights">
					<div class="highlight">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
						<span>Zero-knowledge relay — nodes can't decrypt traffic</span>
					</div>
					<div class="highlight">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
						<span>Forward secrecy via continuous key rotation</span>
					</div>
					<div class="highlight">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
						<span>Out-of-band identity verification via QR</span>
					</div>
				</div>
			</div>

			<div class="security-phone">
				<PhoneFrame
					src={contactScreen}
					alt="Yantagram contact details showing a verification key and a contact verified in person"
					width={300}
				/>
			</div>
		</div>
	</div>
</section>

<style>
	#security {
		padding: 100px 0 120px;
	}

	.security-layout {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 80px;
		align-items: center;
		padding: 64px;
		background:
			radial-gradient(ellipse 60% 70% at 100% 50%, var(--color-primary-dim) 0%, transparent 100%),
			var(--color-bg-deep);
		border: 1px solid var(--color-surface-border);
		border-radius: var(--radius-xl);
	}

	.security-text h2 {
		font-size: clamp(2rem, 4vw, 2.75rem);
		font-weight: 700;
		margin-bottom: 24px;
	}

	.security-text p {
		color: var(--color-text-muted);
		margin-bottom: 16px;
		line-height: 1.75;
		max-width: 540px;
	}

	.security-highlights {
		display: flex;
		flex-direction: column;
		gap: 10px;
		margin-top: 32px;
	}

	.highlight {
		display: flex;
		align-items: center;
		gap: 14px;
		padding: 14px 18px;
		background: var(--color-surface);
		border: 1px solid var(--color-surface-border);
		border-radius: var(--radius-md);
		font-size: 0.9375rem;
		color: var(--color-text);
	}

	.highlight svg {
		flex-shrink: 0;
		box-sizing: content-box;
		padding: 7px;
		border-radius: 50%;
		background: color-mix(in srgb, var(--color-success) 16%, transparent);
		color: var(--color-success);
	}

	.security-phone {
		display: flex;
		justify-content: center;
	}

	@media (max-width: 1024px) {
		.security-layout {
			grid-template-columns: 1fr;
			gap: 48px;
			padding: 48px 32px;
		}
	}

	@media (max-width: 640px) {
		#security {
			padding: 60px 0 80px;
		}

		.security-layout {
			padding: 36px 20px;
		}

		.security-phone :global(.phone) {
			width: 78%;
		}
	}
</style>
