---
import PhoneFrame from './PhoneFrame.astro';
import connectivity from '../assets/screens/connectivity.jpg';

const steps = [
	{
		number: "01",
		title: "Ultimate Privacy",
		description: "Yantagram has no central servers. Your identity and data is stored on your device only.",
	},
	{
		number: "02",
		title: "Messages Traverse the Mesh",
		description: "Your encrypted message hops between nearby devices with Yantagram installed. Each relay extends your reach without ever decrypting your message. The network remains functional during internet outages, natural disasters, or in regions with limited connectivity. ",
	},
	{
		number: "03",
		title: "Internet Connectivity Available",
		description: "Yantagram can use a relay server to send messages over the internet. Messages are always end-to-end encrypted and no data is permanently stored on the server. The relay server can be disabled in settings.",
	},
];
---

<section id="how-it-works">
	<div class="container">
		<div class="section-label">How It Works</div>
		<h2>Why use Yantagram?</h2>
		<p class="section-desc">
            Traditional messaging apps depend on centralized infrastructure that can be monitored, censored, or disabled. 
            Yantagram is a peer-to-peer messaging application that operates over bluetooth mesh networks. No internet, servers, or phone numbers required. 
            Internet connectivity is available to extend range when you want it.
        </p>

		<div class="how-layout">
			<div class="steps">
				{steps.map((step) => (
					<div class="step">
						<div class="step-number">{step.number}</div>
						<div class="step-content">
							<h3>{step.title}</h3>
							<p>{step.description}</p>
						</div>
					</div>
				))}
			</div>

			<div class="how-phone">
				<PhoneFrame
					src={connectivity}
					alt="Yantagram connectivity panel listing two nearby Bluetooth mesh peers and a connected internet relay"
					width={300}
				/>
			</div>
		</div>
	</div>
</section>

<style>
	#how-it-works {
		padding: 100px 0;
	}

	h2 {
		font-size: clamp(2rem, 5vw, 3rem);
		font-weight: 700;
		margin-bottom: 16px;
	}

	.section-desc {
		color: var(--color-text-muted);
		font-size: 1.0625rem;
		max-width: 640px;
		margin-bottom: 56px;
	}

	.how-layout {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 64px;
		align-items: center;
	}

	.steps {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	.step {
		display: flex;
		align-items: flex-start;
		gap: 20px;
		padding: 28px;
		background: var(--color-surface);
		border: 1px solid var(--color-surface-border);
		border-radius: var(--radius-lg);
	}

	.step-number {
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		width: 52px;
		height: 52px;
		border-radius: 50%;
		background: var(--color-primary-dim);
		color: var(--color-primary);
		font-size: 0.9375rem;
		font-weight: 600;
	}

	.step-content h3 {
		font-size: 1.125rem;
		margin-bottom: 8px;
	}

	.step-content p {
		color: var(--color-text-muted);
		font-size: 0.9375rem;
		line-height: 1.7;
	}

	.how-phone {
		display: flex;
		justify-content: center;
	}

	@media (max-width: 1024px) {
		.how-layout {
			grid-template-columns: 1fr;
			gap: 48px;
		}
	}

	@media (max-width: 640px) {
		#how-it-works {
			padding: 80px 0;
		}

		.step {
			flex-direction: column;
			gap: 14px;
			padding: 24px 20px;
		}

		.how-phone :global(.phone) {
			width: 78%;
		}
	}
</style>
