---
const currentYear = new Date().getFullYear();
---

<footer>
	<div class="container">
		<div class="footer-cta">
			<h2>Ready to communicate freely?</h2>
			<button type="button" class="footer-btn" data-open-beta-modal>
				Get Yantagram
			</button>
		</div>

		<div class="footer-bottom">
			<span>&copy; {currentYear} Yantagram.</span>
			<span class="footer-disclaimer">Application security has not been formally audited. Use at your own discretion.</span>
		</div>

		<div class="footer-terms">
			<a href="/terms" class="footer-terms-button">Terms</a>
			<a href="/privacy" class="footer-terms-button">Privacy</a>
		</div>
	</div>
</footer>

<style>
	footer {
		padding: 0 0 48px;
	}

	.footer-terms {
		display: flex;
		gap: 16px;
		font-size: 0.8125rem;
		color: var(--color-text-muted);
	}

	.footer-terms-button:hover {
		color: var(--color-btn-solid-hover)
	}

	.footer-cta {
		text-align: center;
		padding: 100px 0 80px;
		border-top: 1px solid var(--color-surface-border);
		margin-bottom: 64px;
	}

	.footer-cta h2 {
		font-size: clamp(1.75rem, 4vw, 2.5rem);
		font-weight: 700;
		margin-bottom: 12px;
	}

	.footer-cta p {
		color: var(--color-text-muted);
		font-size: 1.0625rem;
		margin-bottom: 32px;
	}

	.footer-btn {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		padding: 14px 28px;
        margin-top: 20px;
		background: var(--color-btn-solid-bg);
		color: var(--color-btn-solid-text);
		border-radius: var(--radius-md);
		font-weight: 600;
		font-size: 0.9375rem;
		transition: all 0.25s;
	}

	.footer-btn:hover {
		background: var(--color-btn-solid-hover);
		transform: translateY(-1px);
		box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
	}

	.footer-grid {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: 64px;
		margin-bottom: 64px;
	}

	.footer-brand {
		max-width: 280px;
	}

	.brand-name {
		display: flex;
		align-items: center;
		gap: 8px;
		font-weight: 600;
		font-size: 1rem;
		margin-bottom: 12px;
		color: var(--color-text);
	}

	.footer-brand p {
		color: var(--color-text-muted);
		font-size: 0.875rem;
		line-height: 1.6;
	}

	.footer-links {
		display: flex;
		gap: 64px;
	}

	.link-col {
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	.link-col h4 {
		font-size: 0.6875rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-text-muted);
		margin-bottom: 4px;
	}

	.link-col a {
		font-size: 0.875rem;
		color: var(--color-text-muted);
		transition: color 0.2s;
	}

	.link-col a:hover {
		color: var(--color-text);
	}

	.footer-bottom {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding-top: 32px;
		border-top: 1px solid var(--color-surface-border);
		font-size: 0.8125rem;
		color: var(--color-text-muted);
	}

	.footer-disclaimer {
		opacity: 0.6;
	}

	@media (max-width: 768px) {
		.footer-grid {
			flex-direction: column;
			gap: 48px;
		}

		.footer-links {
			gap: 48px;
		}

		.footer-bottom {
			flex-direction: column;
			gap: 8px;
			text-align: center;
		}

		.footer-terms {
			flex-direction: column;
			gap: 8px;
			text-align: center;
		}
	}
</style>
