---
import PhoneFrame from './PhoneFrame.astro';
import groupScreen from '../assets/screens/group.jpg';
import myCodeScreen from '../assets/screens/my-code.jpg';

const spotlights = [
	{
		title: "Secure Groups",
		description: "Plan events, stay in touch with your friends. Manage admins and set disappearing messages for the whole group.",
		image: groupScreen,
		alt: "Yantagram group settings for a Ski Trip group with three admin members and 1 day disappearing messages",
	},
	{
		title: "Add Contacts by QR",
		description: "Scan a friend's code to add them. No phone numbers, emails, or usernames to look up.",
		image: myCodeScreen,
		alt: "Yantagram My Code screen showing a QR code to scan to add a contact",
	},
];

const features = [
	{
		icon: "offline",
		tone: "accent",
		title: "Offline-First",
		description: "Works without any internet connection. Messages sync automatically when devices come into range.",
	},
	{
		icon: "disappear",
		tone: "primary",
		title: "Disappearing Messages",
		description: "Set per-conversation retention from 30 seconds to 7 days. Messages are permanently erased from all devices after expiry.",
	},
	{
		icon: "mesh",
		tone: "accent",
		title: "Bluetooth Mesh",
		description: "Messages relay between nearby devices over Bluetooth. No towers, no WiFi, no infrastructure.",
	},
	{
		icon: "lock",
		tone: "success",
		title: "End-to-End Encrypted",
		description: "Your messages are secured with a lock. Only you and the person you're talking to can read messages.",
	},
];

const icons: Record<string, string> = {
	mesh: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><circle cx="12" cy="5" r="2"/><circle cx="5" cy="19" r="2"/><circle cx="19" cy="19" r="2"/><path d="M12 7v4m-5.2 5.8L10 13m4 0l3.2 4.8"/><circle cx="12" cy="12" r="1.5" fill="currentColor" stroke="none"/></svg>`,
	lock: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/><circle cx="12" cy="16" r="1.5" fill="currentColor" stroke="none"/></svg>`,
	offline: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M3 12a9 9 0 0 1 18 0"/><path d="M7 12a5 5 0 0 1 10 0"/><circle cx="12" cy="12" r="1.5" fill="currentColor" stroke="none"/><path d="M12 13.5V20"/><path d="M9 17l3 3 3-3"/></svg>`,
	disappear: `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/><path d="M4 4l16 16" stroke-width="2" opacity="0.4"/></svg>`
};
---

<section id="features">
	<div class="container">
		<div class="section-label">Features</div>
		<h2>The features you'd expect</h2>
		<p class="section-desc">Easily communicate with your contacts with privacy and security baked in.</p>

		<div class="spotlights">
			{spotlights.map((spot) => (
				<div class="spotlight">
					<div class="spotlight-text">
						<h3>{spot.title}</h3>
						<p>{spot.description}</p>
					</div>
					<div class="spotlight-phone">
						<PhoneFrame src={spot.image} alt={spot.alt} width={290} />
					</div>
				</div>
			))}
		</div>

		<div class="features-grid">
			{features.map((feature) => (
				<div class="feature-card">
					<div class={`feature-icon tone-${feature.tone}`} set:html={icons[feature.icon]} />
					<h3>{feature.title}</h3>
					<p>{feature.description}</p>
				</div>
			))}
		</div>
	</div>
</section>

<style>
	#features {
		padding: 40px 0 100px;
		position: relative;
	}

	h2 {
		font-size: clamp(2rem, 5vw, 3rem);
		font-weight: 700;
		margin-bottom: 16px;
	}

	.section-desc {
		color: var(--color-text-muted);
		font-size: 1.0625rem;
		max-width: 480px;
		margin-bottom: 56px;
	}

	.spotlights {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 20px;
		margin-bottom: 20px;
	}

	.spotlight {
		position: relative;
		display: flex;
		flex-direction: column;
		height: 600px;
		overflow: hidden;
		background:
			radial-gradient(ellipse 70% 50% at 50% 100%, var(--color-primary-dim) 0%, transparent 100%),
			var(--color-surface);
		border: 1px solid var(--color-surface-border);
		border-radius: var(--radius-xl);
	}

	.spotlight-text {
		padding: 40px 40px 32px;
	}

	.spotlight-text h3 {
		font-size: 1.5rem;
		margin-bottom: 10px;
	}

	.spotlight-text p {
		color: var(--color-text-muted);
		font-size: 0.9375rem;
		max-width: 400px;
	}

	.spotlight-phone {
		display: flex;
		justify-content: center;
		flex: 1;
	}

	.features-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 20px;
	}

	.feature-card {
		padding: 32px 28px;
		background: var(--color-surface);
		border: 1px solid var(--color-surface-border);
		border-radius: var(--radius-lg);
		transition: background 0.3s, transform 0.3s;
	}

	.feature-card:hover {
		background: var(--color-surface-raised);
		transform: translateY(-2px);
	}

	.feature-icon {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 52px;
		height: 52px;
		margin-bottom: 20px;
		border-radius: 50%;
		background: color-mix(in srgb, var(--tone) 16%, transparent);
		color: var(--tone);
	}

	.tone-primary { --tone: var(--color-primary); }
	.tone-accent { --tone: var(--color-accent); }
	.tone-success { --tone: var(--color-success); }
	.tone-warning { --tone: var(--color-warning); }

	.feature-card h3 {
		font-size: 1.0625rem;
		margin-bottom: 8px;
	}

	.feature-card p {
		font-size: 0.875rem;
		color: var(--color-text-muted);
		line-height: 1.65;
	}

	@media (max-width: 1024px) {
		.features-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 768px) {
		.spotlights {
			grid-template-columns: 1fr;
		}

		.spotlight {
			height: 540px;
		}

		.spotlight-text {
			padding: 32px 24px 24px;
		}
	}

	@media (max-width: 640px) {
		#features {
			padding: 40px 0 80px;
		}

		.features-grid {
			grid-template-columns: 1fr;
		}

		.feature-card {
			padding: 28px 24px;
		}

		.spotlight-phone :global(.phone) {
			width: 78%;
		}
	}
</style>
