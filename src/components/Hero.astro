</section>

<style>
	.hero {
		position: relative;
		min-height: 100vh;
		display: flex;
		align-items: center;
		padding: 0 0 80px;
	}

	.hero-glow {
		position: absolute;
		top: -30%;
		left: 50%;
		transform: translateX(-50%);
		width: 900px;
		height: 600px;
		background: radial-gradient(ellipse, var(--color-primary-glow) 0%, transparent 70%);
		opacity: 0.2;
		pointer-events: none;
		filter: blur(80px);
	}

	.hero-grid-bg {
		position: absolute;
		inset: 0;
		background-image:
			linear-gradient(var(--color-surface-border) 1px, transparent 1px),
			linear-gradient(90deg, var(--color-surface-border) 1px, transparent 1px);
		background-size: 60px 60px;
		mask-image: radial-gradient(ellipse 80% 60% at 50% 40%, black 20%, transparent 70%);
		-webkit-mask-image: radial-gradient(ellipse 80% 60% at 50% 40%, black 20%, transparent 70%);
		pointer-events: none;
	}

	.container {
		position: relative;
		z-index: 1;
		width: 100%;
	}

	.nav {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 28px 0;
		animation: fadeIn 0.8s ease;
	}

	.nav-brand {
		display: flex;
		align-items: center;
		gap: 10px;
		font-weight: 600;
		font-size: 1.1rem;
		color: var(--color-heading);
	}

	.nav-brand svg {
		color: var(--color-primary);
	}

	.nav-links {
		display: flex;
		align-items: center;
		gap: 32px;
	}

	.nav-links a {
		font-size: 0.875rem;
		color: var(--color-text-muted);
		font-weight: 450;
		transition: color 0.2s;
	}

	.nav-links a:hover {
		color: var(--color-text);
	}

	.theme-toggle {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		background: var(--color-surface-raised);
		border: 1px solid var(--color-surface-border);
		border-radius: var(--radius-sm);
		color: var(--color-text-muted);
		cursor: pointer;
		transition: border-color 0.2s, color 0.2s, background 0.2s;
	}

	.theme-toggle:hover {
		border-color: rgba(255, 255, 255, 0.12);
		color: var(--color-text);
	}

	.nav-gh {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 8px 14px;
		background: var(--color-surface-raised);
		border: 1px solid var(--color-surface-border);
		border-radius: var(--radius-sm);
		font-size: 0.8125rem !important;
		color: var(--color-text) !important;
		transition: border-color 0.2s, background 0.2s;
	}

	.nav-gh:hover {
		border-color: rgba(255, 255, 255, 0.12);
		background: rgba(255, 255, 255, 0.05);
	}

	.hero-content {
		max-width: 740px;
		margin: 80px 0 0;
		animation: fadeUp 0.8s ease 0.1s both;
	}

	.hero-badge {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 6px 14px;
		background: var(--color-surface-raised);
		border: 1px solid var(--color-surface-border);
		border-radius: 100px;
		font-size: 0.75rem;
		font-weight: 500;
		color: var(--color-text-muted);
		letter-spacing: 0.02em;
		margin-bottom: 32px;
	}

	.badge-dot {
		width: 6px;
		height: 6px;
		background: var(--color-primary);
		border-radius: 50%;
		animation: pulse 2s infinite;
	}

	h1 {
		font-size: clamp(2.75rem, 7vw, 4.5rem);
		font-weight: 800;
		margin-bottom: 24px;
		line-height: 1.05;
	}

	.hero-gradient {
		background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-accent) 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.hero-sub {
		font-size: 1.125rem;
		color: var(--color-text-muted);
		max-width: 560px;
		line-height: 1.75;
		margin-bottom: 40px;
	}

	.hero-actions {
		display: flex;
		align-items: center;
		gap: 16px;
		flex-wrap: wrap;
	}

	.btn-primary {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		padding: 14px 24px;
		background: linear-gradient(135deg, rgba(34, 211, 238, 0.15), rgba(167, 139, 250, 0.1));
		border: 1px solid rgba(34, 211, 238, 0.3);
		border-radius: var(--radius-md);
		color: var(--color-primary);
		font-weight: 600;
		font-size: 0.9375rem;
		transition: all 0.25s;
	}

	.btn-primary:hover {
		background: linear-gradient(135deg, rgba(34, 211, 238, 0.22), rgba(167, 139, 250, 0.15));
		border-color: rgba(34, 211, 238, 0.5);
		transform: translateY(-1px);
		box-shadow: 0 8px 32px rgba(34, 211, 238, 0.15);
	}

	.btn-ghost {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 14px 20px;
		color: var(--color-text-muted);
		font-weight: 500;
		font-size: 0.9375rem;
		transition: color 0.2s;
	}

	.btn-ghost:hover {
		color: var(--color-text);
	}

	.hero-metrics {
		display: flex;
		align-items: center;
		gap: 0;
		margin-top: 100px;
		padding: 28px 36px;
		background: var(--color-surface);
		border: 1px solid var(--color-surface-border);
		border-radius: var(--radius-lg);
		animation: fadeUp 0.8s ease 0.3s both;
	}

	.metric {
		flex: 1;
		text-align: center;
	}

	.metric-value {
		font-size: 1.5rem;
		font-weight: 700;
		color: var(--color-heading);
		font-family: var(--font-mono);
	}

	.metric-label {
		font-size: 0.8125rem;
		color: var(--color-text-muted);
		margin-top: 4px;
	}

	.metric-divider {
		width: 1px;
		height: 40px;
		background: var(--color-surface-border);
	}

	@media (max-width: 768px) {
		.hero {
			min-height: auto;
			padding: 0 0 60px;
		}

		.nav-links a:not(.nav-gh) {
			display: none;
		}

		.theme-toggle {
			display: flex;
		}

		.hero-content {
			margin-top: 48px;
		}

		.hero-metrics {
			flex-wrap: wrap;
			gap: 24px;
			margin-top: 60px;
			padding: 24px;
		}

		.metric {
			flex: 1 1 40%;
		}

		.metric-divider {
			display: none;
		}
	}
</style>

<script is:inline>
	(function() {
		function updateIcons(theme) {
			var sun = document.getElementById('icon-sun');
			var moon = document.getElementById('icon-moon');
			if (sun && moon) {
				sun.style.display = theme === 'dark' ? 'block' : 'none';
				moon.style.display = theme === 'light' ? 'block' : 'none';
			}
		}

		var current = document.documentElement.getAttribute('data-theme') || 'dark';
		updateIcons(current);

		document.getElementById('theme-toggle').addEventListener('click', function() {
			var html = document.documentElement;
			var cur = html.getAttribute('data-theme') || 'dark';
			var next = cur === 'dark' ? 'light' : 'dark';
			html.setAttribute('data-theme', next);
			localStorage.setItem('theme', next);
			updateIcons(next);
		});
	})();
</script>
