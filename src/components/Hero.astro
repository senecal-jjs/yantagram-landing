					<circle cx="20" cy="20" r="18" stroke="url(#navGrad)" stroke-width="2" opacity="0.8"/>
					<circle cx="20" cy="20" r="6" fill="url(#navGrad)"/>
					<circle cx="20" cy="8" r="2.5" fill="currentColor" opacity="0.6"/>
					<circle cx="20" cy="32" r="2.5" fill="currentColor" opacity="0.6"/>
					<circle cx="8" cy="20" r="2.5" fill="currentColor" opacity="0.6"/>
					<circle cx="32" cy="20" r="2.5" fill="currentColor" opacity="0.6"/>
					<line x1="20" y1="14" x2="20" y2="10.5" stroke="currentColor" stroke-width="1.5" opacity="0.4"/>
					<line x1="20" y1="26" x2="20" y2="29.5" stroke="currentColor" stroke-width="1.5" opacity="0.4"/>
					<line x1="14" y1="20" x2="10.5" y2="20" stroke="currentColor" stroke-width="1.5" opacity="0.4"/>
					<line x1="26" y1="20" x2="29.5" y2="20" stroke="currentColor" stroke-width="1.5" opacity="0.4"/>
