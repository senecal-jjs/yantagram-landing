---
import PhoneFrame from './PhoneFrame.astro';
import chatList from '../assets/screens/chat-list.jpg';
import conversation from '../assets/screens/conversation.jpg';
---

<section class="hero">
	<div class="hero-glow"></div>

	<div class="container">
		<nav class="nav">
			<a href="/" class="nav-brand">
				<img src="/yanta-favicon.svg" alt="Yantagram logo" width="30" height="30" />
				<span>Yantagram</span>
			</a>
			<div class="nav-right">
				<div class="nav-links">
					<a href="#how-it-works">How it Works</a>
					<a href="#features">Features</a>
					<a href="#security">Security</a>
				</div>
				<button class="theme-toggle" id="theme-toggle" aria-label="Toggle theme">
					<svg id="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="display:none">
						<circle cx="12" cy="12" r="5"/>
						<path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
					</svg>
					<svg id="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
						<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
					</svg>
				</button>
			</div>
		</nav>

		<div class="hero-layout">
			<div class="hero-content">
				<div class="hero-badge">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
						<path d="M8.5 8.5a5 5 0 0 0 0 7M15.5 8.5a5 5 0 0 1 0 7M5.6 5.6a9 9 0 0 0 0 12.8M18.4 5.6a9 9 0 0 1 0 12.8"/>
						<circle cx="12" cy="12" r="1.5" fill="currentColor" stroke="none"/>
					</svg>
					No internet required
				</div>

				<h1>
					Messaging without<br />
					<span class="hero-gradient">the middleman</span>
				</h1>

				<p class="hero-sub">
					Simple, reliable, messaging via Bluetooth, no internet required.
					All of the features you'd expect, internet connectivity available when you want it.
				</p>

				<div class="hero-actions">
					<button type="button" class="btn btn-primary" data-open-beta-modal>
						Get Yantagram
					</button>
					<a href="#how-it-works" class="btn btn-surface">
						Learn More
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
							<path d="M7 13l5 5 5-5M7 6l5 5 5-5"/>
						</svg>
					</a>
				</div>
			</div>

			<div class="hero-phones">
				<PhoneFrame
					class="phone-back"
					src={chatList}
					alt="Yantagram chat list showing a direct chat and a group chat, with 2 people nearby over Bluetooth"
					width={270}
					loading="eager"
				/>
				<PhoneFrame
					class="phone-front"
					src={conversation}
					alt="A Yantagram conversation sent while in airplane mode, with messages marked Delivered"
					width={300}
					loading="eager"
				/>
			</div>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		padding: 0 0 100px;
		overflow: hidden;
	}

	.hero-glow {
		position: absolute;
		top: 10%;
		right: -10%;
		width: 900px;
		height: 700px;
		background: radial-gradient(ellipse, var(--color-primary-glow) 0%, transparent 65%);
		opacity: 0.55;
		pointer-events: none;
		filter: blur(60px);
	}

	.container {
		position: relative;
		z-index: 1;
		width: 100%;
	}

	.nav {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 16px;
		padding: 28px 0;
		animation: fadeIn 0.8s ease;
	}

	.nav-brand {
		display: flex;
		align-items: center;
		gap: 12px;
		padding: 8px 22px 8px 8px;
		background: var(--color-surface);
		border: 1px solid var(--color-surface-border);
		border-radius: var(--radius-pill);
		font-weight: 600;
		font-size: 1.1rem;
		color: var(--color-heading);
	}

	.nav-right {
		display: flex;
		align-items: center;
		gap: 12px;
	}

	.nav-links {
		display: flex;
		align-items: center;
		gap: 4px;
		padding: 6px;
		background: var(--color-surface);
		border: 1px solid var(--color-surface-border);
		border-radius: var(--radius-pill);
	}

	.nav-links a {
		padding: 8px 16px;
		border-radius: var(--radius-pill);
		font-size: 0.875rem;
		font-weight: 500;
		color: var(--color-text-muted);
		transition: color 0.2s, background 0.2s;
	}

	.nav-links a:hover {
		color: var(--color-heading);
		background: var(--color-primary-dim);
	}

	.theme-toggle {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 48px;
		height: 48px;
		background: var(--color-surface);
		border: 1px solid var(--color-surface-border);
		border-radius: 50%;
		color: var(--color-text-muted);
		cursor: pointer;
		transition: color 0.2s, background 0.2s;
	}

	.theme-toggle:hover {
		color: var(--color-heading);
		background: var(--color-surface-raised);
	}

	.hero-layout {
		display: grid;
		grid-template-columns: 1.1fr 1fr;
		align-items: center;
		gap: 48px;
		margin-top: 48px;
	}

	.hero-content {
		animation: fadeUp 0.8s ease 0.1s both;
	}

	.hero-badge {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 8px 16px;
		margin-bottom: 28px;
		background: var(--color-surface);
		border: 1px solid var(--color-surface-border);
		border-radius: var(--radius-pill);
		font-size: 0.875rem;
		font-weight: 500;
		color: var(--color-text);
	}

	.hero-badge svg {
		color: var(--color-accent);
	}

	h1 {
		font-size: clamp(2.6rem, 6vw, 4.25rem);
		font-weight: 700;
		margin-bottom: 24px;
		line-height: 1.08;
	}

	.hero-gradient {
		background: var(--gradient-primary);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.hero-sub {
		font-size: 1.125rem;
		color: var(--color-text-muted);
		max-width: 540px;
		line-height: 1.75;
		margin-bottom: 40px;
	}

	.hero-actions {
		display: flex;
		align-items: center;
		gap: 14px;
		flex-wrap: wrap;
	}

	.hero-phones {
		position: relative;
		display: flex;
		justify-content: center;
		align-items: center;
		min-height: 640px;
		animation: fadeUp 0.9s ease 0.25s both;
	}

	.hero-phones :global(.phone-back) {
		position: absolute;
		left: 0;
		top: 20px;
		transform: rotate(-7deg);
		opacity: 0.75;
	}

	.hero-phones :global(.phone-front) {
		position: relative;
		margin-left: 150px;
		margin-top: 60px;
		transform: rotate(3deg);
	}

	@media (max-width: 1024px) {
		.hero-layout {
			grid-template-columns: 1fr;
			gap: 56px;
		}

		.hero-phones {
			min-height: 0;
			max-width: 480px;
			width: 100%;
			margin: 0 auto;
		}
	}

	@media (max-width: 768px) {
		.hero {
			padding: 0 0 60px;
		}

		.nav-links {
			display: none;
		}

		.hero-layout {
			margin-top: 24px;
		}

		.hero-phones :global(.phone-back) {
			width: 52%;
			left: 2%;
			top: 0;
		}

		.hero-phones :global(.phone-front) {
			width: 58%;
			margin-left: 38%;
			margin-top: 40px;
		}
	}
</style>

<script is:inline>
	(function() {
		function updateIcons(theme) {
			var sun = document.getElementById('icon-sun');
			var moon = document.getElementById('icon-moon');
			if (sun && moon) {
				sun.style.display = theme === 'dark' ? 'block' : 'none';
				moon.style.display = theme === 'light' ? 'block' : 'none';
			}
		}

		var current = document.documentElement.getAttribute('data-theme') || 'dark';
		updateIcons(current);

		document.getElementById('theme-toggle').addEventListener('click', function() {
			var html = document.documentElement;
			var cur = html.getAttribute('data-theme') || 'dark';
			var next = cur === 'dark' ? 'light' : 'dark';
			html.setAttribute('data-theme', next);
			localStorage.setItem('theme', next);
			updateIcons(next);
		});
	})();
</script>
